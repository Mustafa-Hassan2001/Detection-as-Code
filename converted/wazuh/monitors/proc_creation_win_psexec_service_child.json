{"type": "monitor", "name": "SIGMA - Process Spawned by the PsExec Service (PSEXESVC)", "description": "Detects processes whose parent is PSEXESVC.exe, the service that Sysinternals PsExec\ncopies to the ADMIN$ share and installs on the remote host. Any child of it is a command\nthat was executed remotely over SMB (lateral movement) via a temporary service (service\nexecution). Detection happens on the *target* host, which is where the evidence is\nreliable regardless of how the operator launched PsExec.\n", "enabled": true, "schedule": {"period": {"interval": 5, "unit": "MINUTES"}}, "inputs": [{"search": {"indices": ["wazuh-archives-*", "wazuh-alerts-*"], "query": {"size": 1, "query": {"bool": {"must": [{"query_string": {"query": "data.win.system.eventID:1 AND data.win.eventdata.parentImage:*\\\\PSEXESVC.exe", "analyze_wildcard": true}}]}}}}}], "tags": ["attack-lateral-movement", "attack-t1021.002", "attack-execution", "attack-t1569.002"], "triggers": [{"name": "generated-trigger", "severity": 3, "condition": {"script": {"source": "ctx.results[0].hits.total.value > 0", "lang": "painless"}}, "actions": []}], "sigma_meta_data": {"rule_id": "0403fbc7-d9f6-4529-a3d4-181aff95fb0c", "threat": []}, "references": ["https://attack.mitre.org/techniques/T1021/002/", "https://attack.mitre.org/techniques/T1569/002/", "https://learn.microsoft.com/en-us/sysinternals/downloads/psexec", "https://github.com/redcanaryco/atomic-red-team/blob/master/atomics/T1569.002/T1569.002.md", "https://github.com/SigmaHQ/sigma/blob/05d1031f537e830b76da53bae2400c5814c89165/rules/windows/process_creation/proc_creation_win_sysinternals_psexesvc_as_system.yml"]}
