((process.executable.caseless:(*\\powershell.exe OR *\\pwsh.exe)) OR (process.pe.original_file_name:(PowerShell.EXE OR pwsh.dll))) AND (process.command_line:(*\ \-e\ * OR *\ \/e\ * OR *\ –e\ * OR *\ —e\ * OR *\ ―e\ *) OR process.command_line:(*\ \-ec\ * OR *\ \/ec\ * OR *\ –ec\ * OR *\ —ec\ * OR *\ ―ec\ *) OR process.command_line:(*\ \-en\ * OR *\ \/en\ * OR *\ –en\ * OR *\ —en\ * OR *\ ―en\ *) OR process.command_line:(*\ \-enc\ * OR *\ \/enc\ * OR *\ –enc\ * OR *\ —enc\ * OR *\ ―enc\ *) OR process.command_line:(*\ \-enco* OR *\ \/enco* OR *\ –enco* OR *\ —enco* OR *\ ―enco*))
