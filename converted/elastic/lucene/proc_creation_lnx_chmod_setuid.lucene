(event.category:process AND event.type:start) AND ((process.executable:*\/chmod AND (process.command_line:(*\ u\+s\ * OR *\ g\+s\ * OR *\ \+s\ * OR *\ 4755\ * OR *\ 4777\ * OR *\ 4711\ * OR *\ 2755\ * OR *\ 6755\ *))) AND (NOT ((process.parent.executable:(*\/dpkg OR *\/rpm OR *\/apt OR *\/apt\-get OR *\/yum OR *\/dnf)) OR (process.parent.command_line:(*\/var\/lib\/dpkg\/info\/* OR *\/var\/tmp\/rpm\-tmp.*)))))
