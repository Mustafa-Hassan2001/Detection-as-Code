(event.category:process AND event.type:start) AND (((process.command_line:(*\/dev\/tcp\/* OR *\/dev\/udp\/*)) OR ((process.executable:(*\/nc OR *\/ncat OR *\/netcat OR *\/nc.traditional)) AND (process.command_line:(*\ \-e\ \/bin\/* OR *\ \-c\ \/bin\/* OR *\ \-e\ sh* OR *\ \-e\ bash*))) OR (process.command_line:*mkfifo* AND process.command_line:*sh\ \-i* AND process.command_line:*nc\ *) OR (process.command_line:*socket* AND process.command_line:*connect* AND process.command_line:*pty.spawn*)) AND (NOT (process.command_line:(*\/dev\/tcp\/127.0.0.1\/* OR *\/dev\/tcp\/localhost\/*))))
