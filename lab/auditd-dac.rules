## auditd watch rules required by the auditd-based Sigma rules (LAB MODE).
## Install:  sudo cp lab/auditd-dac.rules /etc/audit/rules.d/50-dac.rules && sudo augenrules --load
## Verify:   sudo auditctl -l | grep -E 'cron_persistence|ssh_keys'
##
## -w <path> -p wa  = log writes (w) and attribute changes (a); a directory watch is recursive.
## -k <key>         = tag in the SYSCALL record, used for triage and Wazuh/Auditbeat filtering.

## T1053.003 Cron -> rules/linux/auditd/lnx_auditd_cron_file_modification.yml
-w /etc/crontab -p wa -k cron_persistence
-w /etc/cron.d/ -p wa -k cron_persistence
-w /etc/cron.hourly/ -p wa -k cron_persistence
-w /etc/cron.daily/ -p wa -k cron_persistence
-w /etc/cron.weekly/ -p wa -k cron_persistence
-w /etc/cron.monthly/ -p wa -k cron_persistence
-w /var/spool/cron/ -p wa -k cron_persistence

## T1098.004 SSH authorized_keys -> rules/linux/auditd/lnx_auditd_ssh_authorized_keys_modification.yml
## One line per account that should be monitored (watching all of /home would be far too noisy).
-w /root/.ssh/ -p wa -k ssh_keys
## -w /home/<lab-user>/.ssh/ -p wa -k ssh_keys
